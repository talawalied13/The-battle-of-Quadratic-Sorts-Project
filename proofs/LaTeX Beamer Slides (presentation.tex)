\begin{frame}{Green Zone Growth}
\begin{itemize}
  \item At each iteration, the Green Zone grows by one cell
  \item The key is placed in its correct position
  \item Sorted order is preserved
\end{itemize}
\end{frame}

\begin{frame}{Loop Invariant}
\textbf{Invariant Statement:}

\medskip
\emph{At the start of iteration \(i\), the subarray \(L[0 \ldots i-1]\) is sorted.}
\end{frame}

\begin{frame}{Invariant – Initialization}
\begin{itemize}
  \item At \(i = 1\), the subarray contains one element
  \item A single element is always sorted
\end{itemize}

\medskip
Invariant holds before the loop starts.
\end{frame}

\begin{frame}{Invariant – Maintenance}
\begin{itemize}
  \item Assume \(L[0 \ldots i-1]\) is sorted
  \item The key \(L[i]\) is inserted into the correct position
  \item Larger elements are shifted right
\end{itemize}

\medskip
After insertion, \(L[0 \ldots i]\) is sorted.
\end{frame}

\begin{frame}{Invariant – Termination}
\begin{itemize}
  \item Loop ends at \(i = n\)
  \item Invariant guarantees \(L[0 \ldots n-1]\) is sorted
\end{itemize}

\medskip
Insertion Sort is correct.
\end{frame}

