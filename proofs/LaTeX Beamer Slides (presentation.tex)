\begin{frame}{Project Objective}
\begin{itemize}
  \item Compare Bubble Sort and Insertion Sort
  \item Measure performance experimentally
  \item Visualize the logic of Insertion Sort
  \item Prove correctness using a loop invariant
\end{itemize}
\end{frame}

\begin{frame}{Why Visualize Insertion Sort?}
\begin{itemize}
  \item Builds a sorted subarray incrementally
  \item Has a clear invariant
  \item Easy to represent visually
  \item Demonstrates correctness step-by-step
\end{itemize}
\end{frame}

\begin{frame}{Insertion Sort – Visual Model}
\textbf{Color Convention:}
\begin{itemize}
  \item \textcolor{green}{Green Zone}: Sorted part \(L[0 \ldots i-1]\)
  \item \textcolor{red}{Red Cell}: Current key \(L[i]\)
  \item White Cells: Unsorted elements
\end{itemize}
\end{frame}

