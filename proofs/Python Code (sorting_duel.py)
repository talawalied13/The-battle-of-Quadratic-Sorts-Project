import time
import random

def bubble_sort(L):
    n = len(L)
    i = 0
    while i < n:
        swapped = False
        j = 0
        while j < n - i - 1:
            if L[j] > L[j + 1]:
                temp = L[j]
                L[j] = L[j + 1]
                L[j + 1] = temp
                swapped = True
            j += 1
        if not swapped:
            return
        i += 1


def insertion_sort(L):
    i = 1
    while i < len(L):
        current = L[i]
        pos = i
        while pos > 0 and L[pos - 1] > current:
            L[pos] = L[pos - 1]
            pos -= 1
        L[pos] = current
        i += 1


def measure(sort_function, arr):
    start = time.perf_counter()
    sort_function(arr)
    end = time.perf_counter()
    return end - start


def benchmark(N=2000):
    cases = [
        ("Sorted (Best)", list(range(N))),
        ("Random", random.sample(range(N), N)),
        ("Reversed (Worst)", list(range(N, 0, -1)))
    ]

    print("=" * 72)
    print("BENCHMARK RESULTS (N = 2000)")
    print("=" * 72)
    print(f"{'Case':20} {'Bubble (s)':15} {'Insertion (s)':15} Winner")
    print("-" * 72)

    for name, base in cases:
        b1 = base.copy()
        b2 = base.copy()

        t1 = measure(bubble_sort, b1)
        t2 = measure(insertion_sort, b2)

        if abs(t1 - t2) < 1e-4:
            winner = "Tie"
        elif t1 < t2:
            winner = "Bubble"
        else:
            winner = "Insertion"

        print(f"{name:20} {t1:<15.4f} {t2:<15.4f} {winner}")

    print("=" * 72)


def generate_tikz(L, i):
    print("\\begin{tikzpicture}")
    print(f"% Insertion Sort - Step {i}")
    print(f"\\only<{i}>{{")

    for idx in range(len(L)):
        if idx < i:
            color = "green!25"
        elif idx == i:
            color = "red!25"
        else:
            color = "white"

        print(f"  \\node[draw, minimum size=0.9cm, fill={color}] "
              f"at ({idx},0) {{{L[idx]}}};")

    print("}")
    print("\\end{tikzpicture}")

if __name__ == "__main__":
    benchmark()

